# ---------------------------------------------------------------------------
# Example environment file. Copy to `.env` and edit. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
TZ=Africa/Cairo

# --- Database --------------------------------------------------------------
# In Docker Compose use the service name `db`. Outside Docker use localhost.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=civil
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=civil_registry
# Optional full override (wins over the POSTGRES_* parts):
# DATABASE_URL=postgresql+psycopg://civil:change-me@localhost:5432/civil_registry

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE-ME-generate-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_MIN_LENGTH=12

# --- Login protection -------------------------------------------------------
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- CORS -------------------------------------------------------------------
# Comma separated list of allowed origins. No wildcards in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# --- Business rules ---------------------------------------------------------
MIN_PARENT_AGE_YEARS=12
MAX_PAGE_SIZE=200
DEFAULT_PAGE_SIZE=25

# --- Privacy -----------------------------------------------------------------
# Roles for which the national ID is masked to the last 4 digits.
MASK_NATIONAL_ID_ROLES=viewer
AUDIT_LOG_ENABLED=true

# --- Import ------------------------------------------------------------------
IMPORT_MAX_ROWS=2000000
IMPORT_CHUNK_SIZE=5000
IMPORT_WORKER_THREADS=2
IMPORT_STORAGE_DIR=/data/uploads
# Orphaned `processing` jobs are failed when the API starts. `0` fails all of
# them, which is correct for a single process. Set minutes when several
# replicas share the database, so one replica's boot does not fail jobs
# another replica is still committing.
IMPORT_STALE_MINUTES=0

# --- Seed / bootstrap admin --------------------------------------------------
# Used by `make seed` when no admin exists yet. The generated password is
# printed to the console once and must be changed at first login.
BOOTSTRAP_ADMIN_USERNAME=admin

# --- Frontend ----------------------------------------------------------------
# Port the nginx-served frontend is published on. In Docker the SPA calls the
# API through the same origin (`/api/...`), so CORS is not involved.
FRONTEND_PORT=8090
# Only used by `npm run dev`: where the Vite dev server proxies `/api`.
VITE_API_PROXY_TARGET=http://localhost:8010